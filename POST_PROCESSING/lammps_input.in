units real
dimension 3
boundary p p p
atom_style full

pair_style none
bond_style harmonic

read_data "./POST_PROCESSING/LAMMPS_DATA_FILE.data"

timestep 1

velocity all create 310 11031
fix 1 all nve
fix 2 all langevin 310 310 1 93656
dump 1 all custom 1000  "./POST_PROCESSING/hENM_CG_trajectory.lammpstrj" id type xu yu zu

run 100000000
run 100000000
run 100000000
